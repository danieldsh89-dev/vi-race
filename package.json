{
  "name": "vi-race",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=24 <27"
  },
  "scripts": {
    "dev": "vite --config apps/web/vite.config.ts --host 127.0.0.1",
    "build": "npm run export:static && vite build --config apps/web/vite.config.ts && tsx scripts/budget-check.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check": "npm run validate && npm run typecheck && npm test && npm run build",
    "validate": "tsx scripts/validate-config.ts",
    "monitor": "tsx scripts/monitor.ts",
    "export:static": "tsx scripts/export-publication.ts",
    "maintenance": "tsx scripts/maintenance.ts",
    "db:migrate": "tsx scripts/migrate.ts",
    "api:dev": "node scripts/wrangler.mjs dev --config apps/api/wrangler.jsonc",
    "api:types": "node scripts/wrangler.mjs types --config apps/api/wrangler.jsonc apps/api/worker-configuration.d.ts --include-runtime=false",
    "api:build": "node scripts/wrangler.mjs deploy --dry-run --config apps/api/wrangler.jsonc --outdir dist/api",
    "deploy:check": "tsx scripts/deploy-check.ts"
  },
  "dependencies": {
    "lucide-react": "1.79.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "7.18.6",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@cloudflare/workers-types": "5.20261124.1",
    "@playwright/test": "1.65.1",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "prettier": "3.10.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.1",
    "wrangler": "4.167.0"
  }
}
