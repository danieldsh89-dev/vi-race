{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "vi-race-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-24",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1,
  },
  "vars": {
    "ALLOWED_ORIGINS": "https://vi-race.pages.dev,http://127.0.0.1:5173,http://localhost:5173",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "vi-race",
      "database_id": "98b0d87c-282c-45e8-8d9f-dc980102cf1e",
      "migrations_dir": "../../migrations",
    },
  ],
}
